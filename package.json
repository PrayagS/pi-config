{
  "name": "pi-config",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Pi extensions and skills packaged for Pi",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrayagS/pi-config.git"
  },
  "bugs": {
    "url": "https://github.com/PrayagS/pi-config/issues"
  },
  "homepage": "https://github.com/PrayagS/pi-config#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi-config"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/output-style/index.ts",
      "./extensions/caffeinate/index.ts",
      "./extensions/commit/index.ts",
      "./extensions/custom-provider-bedrock-inference-profiles/index.ts",
      "./extensions/pi-web-tools/index.ts",
      "./extensions/interactive-shell/index.ts",
      "./extensions/prompt-history/index.ts",
      "./extensions/prewalk/index.ts",
      "./extensions/notify/index.ts",
      "./extensions/qmd-sessions-indexer/index.ts",
      "./extensions/pi-co-authored-by/index.ts",
      "./extensions/pi-footer/index.ts",
      "./extensions/questionnaire/index.ts",
      "./extensions/sandbox/index.ts",
      "./extensions/tools/index.ts",
      "./extensions/vent/index.ts",
      "./extensions/working-indicator/index.ts",
      "./extensions/pi-dcp/index.ts",
      "./extensions/pi-images/index.ts",
      "./extensions/pi-better-prompt-editor/index.ts",
      "./extensions/pi-truncated-thinking-marker.ts",
      "./extensions/zzz-system-prompt-filter/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "files": [
    "extensions/**",
    "skills/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:caffeinate": "bun test extensions/caffeinate/index.test.ts",
    "test:co-authored-by": "bun test extensions/pi-co-authored-by/index.test.ts",
    "test:output-style": "bun test extensions/output-style/index.test.ts"
  },
  "dependencies": {
    "defuddle": "^0.18.1",
    "jsdom": "^26.0.0",
    "unbash": "4.0.5",
    "unicode-animations": "^1.0.3"
  }
}
