# gruvbox-light: Gruvbox light palette (https://github.com/morhetz/gruvbox, MIT/X11) on the pro-* layout
# Plain matplotlib rc keys: plt.style.use("path/to/gruvbox-light.mplstyle") works in matplotlib too.
# Colours: bg fbf1c7, grid ebdbb2, edge d5c4a1, ticks bdae93, labels 7c6f64, legend 504945, text 3c3836

figure.facecolor: fbf1c7
axes.facecolor: fbf1c7
savefig.facecolor: fbf1c7
axes.edgecolor: d5c4a1
grid.color: ebdbb2
text.color: 3c3836
axes.titlecolor: 3c3836
axes.labelcolor: 7c6f64
xtick.color: bdae93
ytick.color: bdae93
xtick.labelcolor: 7c6f64
ytick.labelcolor: 7c6f64
patch.edgecolor: fbf1c7
legend.labelcolor: 504945
# blue, orange, green, red, purple, aqua, yellow (faded accents)
axes.prop_cycle: cycler('color', ['076678', 'af3a03', '79740e', '9d0006', '8f3f71', '427b58', 'b57614'])
font.family: Inter
font.size: 9
figure.figsize: 7.2, 4.2
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.linewidth: 0.8
axes.titlesize: 12
axes.titleweight: semibold
axes.titlelocation: left
axes.titlepad: 10
axes.labelsize: 9
axes.labelpad: 6
grid.linestyle: -
grid.linewidth: 0.6
lines.linewidth: 1.6
lines.solid_capstyle: round
lines.markersize: 5
patch.linewidth: 0
xtick.major.size: 3
xtick.major.width: 0.8
xtick.major.pad: 5
xtick.labelsize: 8.5
xtick.direction: out
ytick.major.size: 0
ytick.major.pad: 6
ytick.labelsize: 8.5
legend.frameon: False
legend.fontsize: 8.5
legend.handlelength: 1.4
legend.handletextpad: 0.6
legend.columnspacing: 1.4
