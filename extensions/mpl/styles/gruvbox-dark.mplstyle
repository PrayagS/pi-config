# gruvbox-dark: Gruvbox dark palette (https://github.com/morhetz/gruvbox, MIT/X11) on the pro-* layout
# Plain matplotlib rc keys: plt.style.use("path/to/gruvbox-dark.mplstyle") works in matplotlib too.
# Colours: bg 282828, grid 3c3836, edge 504945, ticks 665c54, labels a89984, legend d5c4a1, text ebdbb2

figure.facecolor: 282828
axes.facecolor: 282828
savefig.facecolor: 282828
axes.edgecolor: 504945
grid.color: 3c3836
text.color: ebdbb2
axes.titlecolor: ebdbb2
axes.labelcolor: a89984
xtick.color: 665c54
ytick.color: 665c54
xtick.labelcolor: a89984
ytick.labelcolor: a89984
patch.edgecolor: 282828
legend.labelcolor: d5c4a1
# blue, orange, green, red, purple, aqua, yellow (bright accents)
axes.prop_cycle: cycler('color', ['83a598', 'fe8019', 'b8bb26', 'fb4934', 'd3869b', '8ec07c', 'fabd2f'])
font.family: Inter
font.size: 9
figure.figsize: 7.2, 4.2
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.linewidth: 0.8
axes.titlesize: 12
axes.titleweight: semibold
axes.titlelocation: left
axes.titlepad: 10
axes.labelsize: 9
axes.labelpad: 6
grid.linestyle: -
grid.linewidth: 0.6
lines.linewidth: 1.6
lines.solid_capstyle: round
lines.markersize: 5
patch.linewidth: 0
xtick.major.size: 3
xtick.major.width: 0.8
xtick.major.pad: 5
xtick.labelsize: 8.5
xtick.direction: out
ytick.major.size: 0
ytick.major.pad: 6
ytick.labelsize: 8.5
legend.frameon: False
legend.fontsize: 8.5
legend.handlelength: 1.4
legend.handletextpad: 0.6
legend.columnspacing: 1.4
